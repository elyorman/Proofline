{
  "$defs": {
    "AgentRole": {
      "enum": [
        "tactics",
        "physical",
        "game_state",
        "synthesis",
        "lead",
        "single"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "AttributionProposition": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "attribution",
          "default": "attribution",
          "title": "Type",
          "type": "string"
        },
        "cause": {
          "$ref": "#/$defs/Cause"
        },
        "effect": {
          "description": "id of the change proposition this cause explains",
          "title": "Effect",
          "type": "string"
        },
        "role": {
          "enum": [
            "primary",
            "secondary"
          ],
          "title": "Role",
          "type": "string"
        },
        "hypothesis_id": {
          "title": "Hypothesis Id",
          "type": "string"
        },
        "agent": {
          "$ref": "#/$defs/AgentRole"
        }
      },
      "required": [
        "id",
        "cause",
        "effect",
        "role",
        "hypothesis_id",
        "agent"
      ],
      "title": "AttributionProposition",
      "type": "object"
    },
    "Baseline": {
      "properties": {
        "window": {
          "$ref": "#/$defs/BaselineScope"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "window",
        "value"
      ],
      "title": "Baseline",
      "type": "object"
    },
    "BaselineScope": {
      "enum": [
        "first_half",
        "match_so_far",
        "season_average"
      ],
      "title": "BaselineScope",
      "type": "string"
    },
    "BroadcastCueSpec": {
      "properties": {
        "template": {
          "$ref": "#/$defs/OverlayTemplate"
        },
        "priority": {
          "default": "normal",
          "enum": [
            "low",
            "normal",
            "high"
          ],
          "title": "Priority",
          "type": "string"
        },
        "show_at": {
          "default": "next_dead_ball",
          "enum": [
            "immediate",
            "next_dead_ball"
          ],
          "title": "Show At",
          "type": "string"
        },
        "max_delay_s": {
          "default": 45,
          "minimum": 0,
          "title": "Max Delay S",
          "type": "integer"
        },
        "duration_s": {
          "default": 8,
          "minimum": 1,
          "title": "Duration S",
          "type": "integer"
        },
        "fields": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "integer"
              }
            ]
          },
          "title": "Fields",
          "type": "object"
        }
      },
      "required": [
        "template",
        "fields"
      ],
      "title": "BroadcastCueSpec",
      "type": "object"
    },
    "CardStatus": {
      "enum": [
        "proposed",
        "investigating",
        "cross_examined",
        "verified",
        "rejected",
        "scheduled",
        "shown",
        "expired",
        "killed",
        "revised",
        "withdrawn"
      ],
      "title": "CardStatus",
      "type": "string"
    },
    "CaseOutcome": {
      "description": "What the investigation concluded. Drives which card variant renders.",
      "enum": [
        "explained",
        "other",
        "none"
      ],
      "title": "CaseOutcome",
      "type": "string"
    },
    "Cause": {
      "enum": [
        "tactical.press_intensity_up",
        "tactical.press_intensity_down",
        "tactical.block_deeper",
        "tactical.block_higher",
        "tactical.formation_change",
        "tactical.flank_overload",
        "physical.unit_fatigue",
        "physical.player_fatigue",
        "physical.fresh_legs_substitution",
        "game_state.protecting_lead",
        "game_state.chasing_result",
        "game_state.numerical_change",
        "other",
        "none"
      ],
      "title": "Cause",
      "type": "string"
    },
    "ChangeProposition": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "change",
          "default": "change",
          "title": "Type",
          "type": "string"
        },
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "window": {
          "$ref": "#/$defs/Window"
        },
        "baseline": {
          "$ref": "#/$defs/BaselineScope"
        }
      },
      "required": [
        "id",
        "metric",
        "subject",
        "direction",
        "window",
        "baseline"
      ],
      "title": "ChangeProposition",
      "type": "object"
    },
    "CheckResult": {
      "enum": [
        "passed",
        "corrected",
        "failed",
        "skipped"
      ],
      "title": "CheckResult",
      "type": "string"
    },
    "DecisiveTest": {
      "description": "One side's prediction for minutes nobody had seen when it was made: a move its cause\nimplies and the rival's would not cause (up or down), or a number its cause leaves at\nordinary play where the rival's would move it (flat). Code measures it once the minutes\nare played; a reading too thin to measure does not hold.",
      "properties": {
        "side": {
          "enum": [
            "primary",
            "rival"
          ],
          "title": "Side",
          "type": "string"
        },
        "hypothesis_id": {
          "title": "Hypothesis Id",
          "type": "string"
        },
        "cause": {
          "$ref": "#/$defs/Cause"
        },
        "agent": {
          "$ref": "#/$defs/AgentRole"
        },
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "sigmas": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "measured, signed, against the first half",
          "title": "Sigmas"
        },
        "holds": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holds"
        },
        "measured": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "what code read, or why it could not",
          "title": "Measured"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        }
      },
      "required": [
        "side",
        "hypothesis_id",
        "cause",
        "agent",
        "metric",
        "subject",
        "direction",
        "reason"
      ],
      "title": "DecisiveTest",
      "type": "object"
    },
    "DependsOn": {
      "properties": {
        "evidence_sets": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Sets",
          "type": "array"
        },
        "data_version": {
          "title": "Data Version",
          "type": "string"
        }
      },
      "required": [
        "evidence_sets",
        "data_version"
      ],
      "title": "DependsOn",
      "type": "object"
    },
    "Direction": {
      "enum": [
        "up",
        "down",
        "flat"
      ],
      "title": "Direction",
      "type": "string"
    },
    "Evidence": {
      "properties": {
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/Window"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "baseline": {
          "$ref": "#/$defs/Baseline"
        },
        "n_events": {
          "minimum": 0,
          "title": "N Events",
          "type": "integer"
        },
        "tool_call_id": {
          "title": "Tool Call Id",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "subject",
        "window",
        "value",
        "baseline",
        "n_events",
        "tool_call_id"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FollowUp": {
      "description": "Keep watching: causes survived beside the primary and the data could not tell them\napart, so each side pre-registered a decisive test for the minutes after the card. Only\nthe primary's holding confirms it; only one rival's overturns it to that rival; anything\nelse leaves it open.",
      "properties": {
        "window": {
          "$ref": "#/$defs/Window",
          "description": "the minutes not yet played when the tests were made"
        },
        "rivals": {
          "items": {
            "$ref": "#/$defs/Rival"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Rivals",
          "type": "array"
        },
        "tests": {
          "items": {
            "$ref": "#/$defs/DecisiveTest"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Tests",
          "type": "array"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "confirmed",
            "overturned",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "window",
        "rivals",
        "tests"
      ],
      "title": "FollowUp",
      "type": "object"
    },
    "InsightCard": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "match_id": {
          "title": "Match Id",
          "type": "string"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "origin": {
          "default": "auto",
          "enum": [
            "auto",
            "on_demand"
          ],
          "title": "Origin",
          "type": "string"
        },
        "lane": {
          "default": "full",
          "enum": [
            "fast",
            "full"
          ],
          "title": "Lane",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CardStatus",
          "default": "proposed"
        },
        "case_outcome": {
          "$ref": "#/$defs/CaseOutcome"
        },
        "moment_type": {
          "$ref": "#/$defs/MomentType"
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "timing": {
          "$ref": "#/$defs/Timing"
        },
        "propositions": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/ChangeProposition"
              },
              {
                "$ref": "#/$defs/AttributionProposition"
              }
            ]
          },
          "minItems": 1,
          "title": "Propositions",
          "type": "array"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "depends_on": {
          "$ref": "#/$defs/DependsOn"
        },
        "rejected_alternatives": {
          "items": {
            "$ref": "#/$defs/RejectedAlternative"
          },
          "title": "Rejected Alternatives",
          "type": "array"
        },
        "investigation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Investigation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/Verification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "salience": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Salience",
          "type": "string"
        },
        "variants": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "description": "audience -> locale -> text",
          "title": "Variants",
          "type": "object"
        },
        "broadcast_cue": {
          "anyOf": [
            {
              "$ref": "#/$defs/BroadcastCueSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "revisions": {
          "items": {
            "$ref": "#/$defs/Revision"
          },
          "title": "Revisions",
          "type": "array"
        },
        "follow_up": {
          "anyOf": [
            {
              "$ref": "#/$defs/FollowUp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        },
        "superseded_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Superseded By"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "id",
        "match_id",
        "case_id",
        "case_outcome",
        "moment_type",
        "subject",
        "timing",
        "propositions",
        "claim",
        "depends_on",
        "provenance"
      ],
      "title": "InsightCard",
      "type": "object"
    },
    "Investigation": {
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/AgentRole"
          },
          "title": "Agents",
          "type": "array"
        },
        "preregistered_predictions": {
          "minimum": 0,
          "title": "Preregistered Predictions",
          "type": "integer"
        },
        "tool_calls": {
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "budget": {
          "minimum": 0,
          "title": "Budget",
          "type": "integer"
        },
        "cross_examination": {
          "default": "",
          "title": "Cross Examination",
          "type": "string"
        },
        "recovered_from_checkpoint": {
          "default": false,
          "title": "Recovered From Checkpoint",
          "type": "boolean"
        }
      },
      "required": [
        "agents",
        "preregistered_predictions",
        "tool_calls",
        "budget"
      ],
      "title": "Investigation",
      "type": "object"
    },
    "LanguageLevel": {
      "enum": [
        "assertive",
        "measured",
        "tentative"
      ],
      "title": "LanguageLevel",
      "type": "string"
    },
    "MatchClock": {
      "description": "Period plus elapsed minute and second within that period's own numbering.\n\n`minute` is the on-screen minute: 0-45+ in the first half, 45-90+ in the second.",
      "properties": {
        "period": {
          "enum": [
            1,
            2
          ],
          "title": "Period",
          "type": "integer"
        },
        "minute": {
          "maximum": 130,
          "minimum": 0,
          "title": "Minute",
          "type": "integer"
        },
        "second": {
          "maximum": 59,
          "minimum": 0,
          "title": "Second",
          "type": "integer"
        }
      },
      "required": [
        "period",
        "minute",
        "second"
      ],
      "title": "MatchClock",
      "type": "object"
    },
    "Metric": {
      "enum": [
        "ppda",
        "press_intensity",
        "pressure_rate",
        "long_ball_share",
        "field_tilt",
        "channel_share_left",
        "channel_share_centre",
        "channel_share_right",
        "pass_accuracy",
        "pass_accuracy_under_pressure",
        "pass_difficulty",
        "xg",
        "sprint_count",
        "sprint_speed",
        "high_intensity_run_rate",
        "momentum",
        "control_chaos",
        "rhythm",
        "line_height",
        "ball_speed",
        "shot_speed",
        "possession_share",
        "distance_covered"
      ],
      "title": "Metric",
      "type": "string"
    },
    "MomentType": {
      "enum": [
        "pressure_shift",
        "momentum_swing",
        "control_to_chaos",
        "chaos_to_control",
        "shape_change",
        "fatigue_signal",
        "individual_spike",
        "milestone",
        "key_event"
      ],
      "title": "MomentType",
      "type": "string"
    },
    "OverlayTemplate": {
      "enum": [
        "player_name_tag",
        "speed_distance_tag",
        "shot_speed",
        "pass_difficulty",
        "pressure_shift_bar",
        "momentum_strip",
        "control_chaos_gauge",
        "shape_change",
        "fatigue_warning",
        "milestone_badge",
        "update_banner",
        "withdrawal_banner"
      ],
      "title": "OverlayTemplate",
      "type": "string"
    },
    "Persistence": {
      "description": "A change the detector saw, re-measured by code over the minutes after it fired, events\nthe detector never read, in standard deviations of normal variation (spec \u00a79.1).",
      "properties": {
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "window": {
          "$ref": "#/$defs/Window"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "baseline": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline"
        },
        "n_events": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Events"
        },
        "sigmas": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sigmas"
        },
        "holds": {
          "title": "Holds",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        }
      },
      "required": [
        "metric",
        "subject",
        "direction",
        "window",
        "holds",
        "reason"
      ],
      "title": "Persistence",
      "type": "object"
    },
    "Premise": {
      "additionalProperties": false,
      "description": "What a question assumes, as a change since a minute against the first half.",
      "properties": {
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "since": {
          "$ref": "#/$defs/MatchClock"
        }
      },
      "required": [
        "metric",
        "subject",
        "direction",
        "since"
      ],
      "title": "Premise",
      "type": "object"
    },
    "Provenance": {
      "properties": {
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        },
        "foundry_eval_run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Foundry Eval Run"
        }
      },
      "required": [
        "trace_id"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        },
        "match_id": {
          "title": "Match Id",
          "type": "string"
        },
        "asked_at": {
          "$ref": "#/$defs/MatchClock",
          "description": "the moment the viewer asks, in the second half"
        },
        "text": {
          "maxLength": 300,
          "minLength": 3,
          "title": "Text",
          "type": "string"
        },
        "locale": {
          "default": "en",
          "enum": [
            "en",
            "es"
          ],
          "title": "Locale",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "match_id",
        "asked_at",
        "text"
      ],
      "title": "Question",
      "type": "object"
    },
    "RejectedAlternative": {
      "properties": {
        "hypothesis_id": {
          "title": "Hypothesis Id",
          "type": "string"
        },
        "taxonomy": {
          "$ref": "#/$defs/Cause"
        },
        "agent": {
          "$ref": "#/$defs/AgentRole"
        },
        "team": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the team the ruled-out cause is about",
          "title": "Team"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "rejected_by": {
          "enum": [
            "test",
            "cross_examination",
            "verifier",
            "follow_up"
          ],
          "title": "Rejected By",
          "type": "string"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        }
      },
      "required": [
        "hypothesis_id",
        "taxonomy",
        "agent",
        "reason",
        "rejected_by"
      ],
      "title": "RejectedAlternative",
      "type": "object"
    },
    "Revision": {
      "properties": {
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
