{
  "$defs": {
    "Cause": {
      "enum": [
        "tactical.press_intensity_up",
        "tactical.press_intensity_down",
        "tactical.block_deeper",
        "tactical.block_higher",
        "tactical.formation_change",
        "tactical.flank_overload",
        "physical.unit_fatigue",
        "physical.player_fatigue",
        "physical.fresh_legs_substitution",
        "game_state.protecting_lead",
        "game_state.chasing_result",
        "game_state.numerical_change",
        "other",
        "none"
      ],
      "title": "Cause",
      "type": "string"
    },
    "Direction": {
      "enum": [
        "up",
        "down",
        "flat"
      ],
      "title": "Direction",
      "type": "string"
    },
    "Exclusion": {
      "description": "A planted script left out of recall as not_observable, with the numbers why.",
      "properties": {
        "script_id": {
          "title": "Script Id",
          "type": "string"
        },
        "cause": {
          "$ref": "#/$defs/Cause"
        },
        "rule": {
          "$ref": "#/$defs/ExclusionRule"
        },
        "observables": {
          "items": {
            "$ref": "#/$defs/ObservableCheck"
          },
          "minItems": 1,
          "title": "Observables",
          "type": "array"
        }
      },
      "required": [
        "script_id",
        "cause",
        "rule",
        "observables"
      ],
      "title": "Exclusion",
      "type": "object"
    },
    "ExclusionRule": {
      "description": "Spec \u00a77.2. Each excluded script is counted once, under the first rule it meets.",
      "enum": [
        "paired_effect",
        "single_match"
      ],
      "title": "ExclusionRule",
      "type": "string"
    },
    "Metric": {
      "enum": [
        "ppda",
        "press_intensity",
        "pressure_rate",
        "long_ball_share",
        "field_tilt",
        "channel_share_left",
        "channel_share_centre",
        "channel_share_right",
        "pass_accuracy",
        "pass_accuracy_under_pressure",
        "pass_difficulty",
        "xg",
        "sprint_count",
        "high_intensity_run_rate",
        "momentum",
        "control_chaos",
        "rhythm",
        "line_height",
        "ball_speed",
        "shot_speed",
        "possession_share",
        "distance_covered"
      ],
      "title": "Metric",
      "type": "string"
    },
    "MetricEstimate": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "suite": {
          "$ref": "#/$defs/Suite"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "ci_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Low"
        },
        "ci_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci High"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "suite",
        "value",
        "n"
      ],
      "title": "MetricEstimate",
      "type": "object"
    },
    "ObservableCheck": {
      "properties": {
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "separation": {
          "description": "natural sds, positive when it moves `direction`",
          "title": "Separation",
          "type": "number"
        },
        "ci_low": {
          "title": "Ci Low",
          "type": "number"
        },
        "ci_high": {
          "title": "Ci High",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "subject",
        "direction",
        "separation",
        "ci_low",
        "ci_high"
      ],
      "title": "ObservableCheck",
      "type": "object"
    },
    "Split": {
      "enum": [
        "dev",
        "heldout"
      ],
      "title": "Split",
      "type": "string"
    },
    "Suite": {
      "enum": [
        "planted",
        "decoys",
        "corrections",
        "confounded",
        "seeded_false_claims"
      ],
      "title": "Suite",
      "type": "string"
    },
    "Variant": {
      "enum": [
        "A",
        "B",
        "C"
      ],
      "title": "Variant",
      "type": "string"
    }
  },
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "variant": {
      "$ref": "#/$defs/Variant"
    },
    "suites": {
      "items": {
        "$ref": "#/$defs/Suite"
      },
      "minItems": 1,
      "title": "Suites",
      "type": "array"
    },
    "split": {
      "$ref": "#/$defs/Split"
    },
    "model_tier": {
      "description": "dev | final",
      "title": "Model Tier",
      "type": "string"
    },
    "match_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Match Ids",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricEstimate"
      },
      "minItems": 1,
      "title": "Metrics",
      "type": "array"
    },
    "started_at_ms": {
      "minimum": 0,
      "title": "Started At Ms",
      "type": "integer"
    },
    "finished_at_ms": {
      "minimum": 0,
      "title": "Finished At Ms",
      "type": "integer"
    },
    "input_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "output_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "cost_usd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Usd"
    },
    "foundry_eval_run": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Foundry Eval Run"
    },
    "not_observable": {
      "description": "planted scripts excluded from recall (spec \u00a77.2)",
      "items": {
        "$ref": "#/$defs/Exclusion"
      },
      "title": "Not Observable",
      "type": "array"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "variant",
    "suites",
    "split",
    "model_tier",
    "match_ids",
    "metrics",
    "started_at_ms",
    "finished_at_ms"
  ],
  "title": "EvalRun",
  "type": "object"
}
