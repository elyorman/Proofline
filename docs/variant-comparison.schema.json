{
  "$defs": {
    "MetricEstimate": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "suite": {
          "anyOf": [
            {
              "$ref": "#/$defs/Suite"
            },
            {
              "const": "combined",
              "type": "string"
            }
          ],
          "title": "Suite"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "ci_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Low"
        },
        "ci_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci High"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "ci_method": {
          "anyOf": [
            {
              "enum": [
                "wilson",
                "paired_match_bootstrap"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Method"
        }
      },
      "required": [
        "name",
        "suite",
        "value",
        "n"
      ],
      "title": "MetricEstimate",
      "type": "object"
    },
    "Split": {
      "enum": [
        "dev",
        "heldout"
      ],
      "title": "Split",
      "type": "string"
    },
    "Suite": {
      "enum": [
        "planted",
        "decoys",
        "corrections",
        "confounded",
        "seeded_false_claims",
        "questions"
      ],
      "title": "Suite",
      "type": "string"
    },
    "Variant": {
      "enum": [
        "A",
        "B",
        "C"
      ],
      "title": "Variant",
      "type": "string"
    }
  },
  "description": "Paired comparison of two runs on the same cases, e.g. Proofline vs single agent.\n\n`difference` is variant_a minus variant_b, with a paired bootstrap CI over the\ncases both runs scored; never derived from the two runs' separate CIs. Stored in\neval_runs beside the runs it compares, so the README's A-vs-B number has a record.",
  "properties": {
    "comparison_id": {
      "title": "Comparison Id",
      "type": "string"
    },
    "run_a": {
      "description": "run_id of variant_a's EvalRun",
      "title": "Run A",
      "type": "string"
    },
    "run_b": {
      "description": "run_id of variant_b's EvalRun",
      "title": "Run B",
      "type": "string"
    },
    "variant_a": {
      "anyOf": [
        {
          "$ref": "#/$defs/Variant"
        },
        {
          "const": "P",
          "type": "string"
        }
      ],
      "title": "Variant A"
    },
    "variant_b": {
      "anyOf": [
        {
          "$ref": "#/$defs/Variant"
        },
        {
          "const": "P",
          "type": "string"
        }
      ],
      "title": "Variant B"
    },
    "split": {
      "$ref": "#/$defs/Split"
    },
    "difference": {
      "$ref": "#/$defs/MetricEstimate"
    },
    "flag_set_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Flag Set Id"
    },
    "suite_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Suite Digest"
    },
    "match_ids": {
      "items": {
        "type": "string"
      },
      "title": "Match Ids",
      "type": "array"
    },
    "bootstrap_seed": {
      "default": 0,
      "title": "Bootstrap Seed",
      "type": "integer"
    },
    "bootstrap_resamples": {
      "default": 2000,
      "minimum": 1,
      "title": "Bootstrap Resamples",
      "type": "integer"
    },
    "unverified_configuration": {
      "description": "configuration absent from both batch inputs",
      "items": {
        "type": "string"
      },
      "title": "Unverified Configuration",
      "type": "array"
    },
    "failed_cases_a": {
      "default": 0,
      "minimum": 0,
      "title": "Failed Cases A",
      "type": "integer"
    },
    "failed_cases_b": {
      "default": 0,
      "minimum": 0,
      "title": "Failed Cases B",
      "type": "integer"
    },
    "comparison_type": {
      "default": "cases",
      "enum": [
        "cases",
        "questions"
      ],
      "title": "Comparison Type",
      "type": "string"
    },
    "question_set_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Question Set Digest"
    },
    "question_ids": {
      "items": {
        "type": "string"
      },
      "title": "Question Ids",
      "type": "array"
    },
    "unpaired_question_ids": {
      "items": {
        "type": "string"
      },
      "title": "Unpaired Question Ids",
      "type": "array"
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "tool_call_budget": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Call Budget"
    }
  },
  "required": [
    "comparison_id",
    "run_a",
    "run_b",
    "variant_a",
    "variant_b",
    "split",
    "difference"
  ],
  "title": "VariantComparison",
  "type": "object"
}
