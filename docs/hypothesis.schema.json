{
  "$defs": {
    "AgentRole": {
      "enum": [
        "tactics",
        "physical",
        "game_state",
        "synthesis",
        "single"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "BaselineScope": {
      "enum": [
        "first_half",
        "match_so_far",
        "season_average"
      ],
      "title": "BaselineScope",
      "type": "string"
    },
    "Cause": {
      "enum": [
        "tactical.press_intensity_up",
        "tactical.press_intensity_down",
        "tactical.block_deeper",
        "tactical.block_higher",
        "tactical.formation_change",
        "tactical.flank_overload",
        "physical.unit_fatigue",
        "physical.player_fatigue",
        "physical.fresh_legs_substitution",
        "game_state.protecting_lead",
        "game_state.chasing_result",
        "game_state.numerical_change",
        "other",
        "none"
      ],
      "title": "Cause",
      "type": "string"
    },
    "Direction": {
      "enum": [
        "up",
        "down",
        "flat"
      ],
      "title": "Direction",
      "type": "string"
    },
    "MatchClock": {
      "description": "Period plus elapsed minute and second within that period's own numbering.\n\n`minute` is the on-screen minute: 0-45+ in the first half, 45-90+ in the second.",
      "properties": {
        "period": {
          "enum": [
            1,
            2
          ],
          "title": "Period",
          "type": "integer"
        },
        "minute": {
          "maximum": 130,
          "minimum": 0,
          "title": "Minute",
          "type": "integer"
        },
        "second": {
          "maximum": 59,
          "minimum": 0,
          "title": "Second",
          "type": "integer"
        }
      },
      "required": [
        "period",
        "minute",
        "second"
      ],
      "title": "MatchClock",
      "type": "object"
    },
    "Metric": {
      "enum": [
        "ppda",
        "press_intensity",
        "pressure_rate",
        "long_ball_share",
        "field_tilt",
        "channel_share_left",
        "channel_share_centre",
        "channel_share_right",
        "pass_accuracy",
        "pass_accuracy_under_pressure",
        "pass_difficulty",
        "xg",
        "sprint_count",
        "sprint_speed",
        "high_intensity_run_rate",
        "momentum",
        "control_chaos",
        "rhythm",
        "line_height",
        "ball_speed",
        "shot_speed",
        "possession_share",
        "distance_covered"
      ],
      "title": "Metric",
      "type": "string"
    },
    "Prediction": {
      "properties": {
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "subject": {
          "description": "team, team.unit, or player id",
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/Window"
        },
        "compare_to": {
          "$ref": "#/$defs/BaselineScope"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "threshold_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThresholdKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "defaults to the metric's pinned kind"
        },
        "min_change": {
          "description": "relative fraction, absolute units, or sigmas; for flat, the tolerance",
          "exclusiveMinimum": 0,
          "title": "Min Change",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "subject",
        "window",
        "compare_to",
        "direction",
        "min_change"
      ],
      "title": "Prediction",
      "type": "object"
    },
    "ThresholdKind": {
      "description": "How a predicted change is measured against its baseline. Changes are signed.\n\nRELATIVE: (value - baseline) / |baseline|; only for metrics pinned relative,\ni.e. ratios and counts with a baseline well above zero.\nABSOLUTE: value - baseline, in the metric's own units; shares and rates bounded in\n0-1 (long-ball share, pressure rate, channel shares) are pinned absolute.\nSIGMA: (value - baseline) / std from the `distribution` tool; the default\nfor signed or near-zero metrics such as momentum.",
      "enum": [
        "relative",
        "absolute",
        "sigma"
      ],
      "title": "ThresholdKind",
      "type": "string"
    },
    "Window": {
      "description": "Half-open match-clock window [start, end). Accepts \"58:00-63:00\".",
      "properties": {
        "start": {
          "$ref": "#/$defs/MatchClock"
        },
        "end": {
          "$ref": "#/$defs/MatchClock"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "properties": {
    "hypothesis_id": {
      "title": "Hypothesis Id",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "agent": {
      "$ref": "#/$defs/AgentRole"
    },
    "taxonomy": {
      "$ref": "#/$defs/Cause"
    },
    "prediction": {
      "$ref": "#/$defs/Prediction"
    }
  },
  "required": [
    "hypothesis_id",
    "case_id",
    "agent",
    "taxonomy",
    "prediction"
  ],
  "title": "Hypothesis",
  "type": "object"
}
