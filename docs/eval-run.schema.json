{
  "$defs": {
    "CardOutcome": {
      "description": "One final published card's result. `correct` is the recall match, in time; `holds`\nis what precision counts: the card names the planted change while it runs, which it does\nfrom its start to full time (spec \u00a711.1).",
      "properties": {
        "card_id": {
          "title": "Card Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "outcome": {
          "$ref": "#/$defs/CaseOutcome"
        },
        "correct": {
          "title": "Correct",
          "type": "boolean"
        },
        "holds": {
          "title": "Holds",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "card_id",
        "revision",
        "outcome",
        "correct",
        "holds",
        "reason"
      ],
      "title": "CardOutcome",
      "type": "object"
    },
    "CaseOutcome": {
      "description": "What the investigation concluded. Drives which card variant renders.",
      "enum": [
        "explained",
        "other",
        "none"
      ],
      "title": "CaseOutcome",
      "type": "string"
    },
    "Cause": {
      "enum": [
        "tactical.press_intensity_up",
        "tactical.press_intensity_down",
        "tactical.block_deeper",
        "tactical.block_higher",
        "tactical.formation_change",
        "tactical.flank_overload",
        "physical.unit_fatigue",
        "physical.player_fatigue",
        "physical.fresh_legs_substitution",
        "game_state.protecting_lead",
        "game_state.chasing_result",
        "game_state.numerical_change",
        "other",
        "none"
      ],
      "title": "Cause",
      "type": "string"
    },
    "Direction": {
      "enum": [
        "up",
        "down",
        "flat"
      ],
      "title": "Direction",
      "type": "string"
    },
    "Exclusion": {
      "description": "A planted match left out of recall as not_observable, with the numbers why.",
      "properties": {
        "match_id": {
          "title": "Match Id",
          "type": "string"
        },
        "cause": {
          "$ref": "#/$defs/Cause"
        },
        "rule": {
          "$ref": "#/$defs/ExclusionRule"
        },
        "observables": {
          "items": {
            "$ref": "#/$defs/ObservableCheck"
          },
          "minItems": 1,
          "title": "Observables",
          "type": "array"
        }
      },
      "required": [
        "match_id",
        "cause",
        "rule",
        "observables"
      ],
      "title": "Exclusion",
      "type": "object"
    },
    "ExclusionRule": {
      "description": "Spec \u00a77.2. Each excluded script is counted once, under the first rule it meets.",
      "enum": [
        "no_paired_effect",
        "no_separation"
      ],
      "title": "ExclusionRule",
      "type": "string"
    },
    "FlagSet": {
      "description": "The frozen not_observable flags of one planted suite split, with their provenance.\n\nEvery planted EvalRun embeds the same flag set, frozen before either variant ran, so\nboth variants exclude the same matches and the scoreboard can show why.",
      "properties": {
        "split": {
          "$ref": "#/$defs/Split"
        },
        "match_ids": {
          "description": "every planted match considered",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Match Ids",
          "type": "array"
        },
        "paired_seeds": {
          "additionalProperties": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "description": "per match, the seeds measured",
          "title": "Paired Seeds",
          "type": "object"
        },
        "frozen_at_ms": {
          "description": "epoch milliseconds",
          "minimum": 0,
          "title": "Frozen At Ms",
          "type": "integer"
        },
        "exclusions": {
          "items": {
            "$ref": "#/$defs/Exclusion"
          },
          "title": "Exclusions",
          "type": "array"
        }
      },
      "required": [
        "split",
        "match_ids",
        "paired_seeds",
        "frozen_at_ms"
      ],
      "title": "FlagSet",
      "type": "object"
    },
    "MatchOutcome": {
      "properties": {
        "match_id": {
          "title": "Match Id",
          "type": "string"
        },
        "suite": {
          "$ref": "#/$defs/Suite"
        },
        "correct": {
          "title": "Correct",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "excluded": {
          "default": false,
          "title": "Excluded",
          "type": "boolean"
        },
        "cards": {
          "items": {
            "$ref": "#/$defs/CardOutcome"
          },
          "title": "Cards",
          "type": "array"
        },
        "case_errors": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Case Errors",
          "type": "object"
        },
        "failed_cases": {
          "default": 0,
          "minimum": 0,
          "title": "Failed Cases",
          "type": "integer"
        }
      },
      "required": [
        "match_id",
        "suite",
        "correct",
        "reason"
      ],
      "title": "MatchOutcome",
      "type": "object"
    },
    "Metric": {
      "enum": [
        "ppda",
        "press_intensity",
        "pressure_rate",
        "long_ball_share",
        "field_tilt",
        "channel_share_left",
        "channel_share_centre",
        "channel_share_right",
        "pass_accuracy",
        "pass_accuracy_under_pressure",
        "pass_difficulty",
        "xg",
        "sprint_count",
        "sprint_speed",
        "high_intensity_run_rate",
        "momentum",
        "control_chaos",
        "rhythm",
        "line_height",
        "ball_speed",
        "shot_speed",
        "possession_share",
        "distance_covered"
      ],
      "title": "Metric",
      "type": "string"
    },
    "MetricEstimate": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "suite": {
          "anyOf": [
            {
              "$ref": "#/$defs/Suite"
            },
            {
              "const": "combined",
              "type": "string"
            }
          ],
          "title": "Suite"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "ci_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Low"
        },
        "ci_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci High"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "suite",
        "value",
        "n"
      ],
      "title": "MetricEstimate",
      "type": "object"
    },
    "ObservableCheck": {
      "description": "One observable of an excluded script, with the numbers spec \u00a77.2 judges it by.\n\n`separation` is signed like the engine's (engine/visibility.py) and like the\npaired-effect interval: positive when the observable rose. Both are judged in\n`direction`, the way the observable moves when the class is present.",
      "properties": {
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "separation": {
          "description": "natural sds, signed: positive when it rose",
          "title": "Separation",
          "type": "number"
        },
        "ci_low": {
          "title": "Ci Low",
          "type": "number"
        },
        "ci_high": {
          "title": "Ci High",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "subject",
        "direction",
        "separation",
        "ci_low",
        "ci_high"
      ],
      "title": "ObservableCheck",
      "type": "object"
    },
    "Split": {
      "enum": [
        "dev",
        "heldout"
      ],
      "title": "Split",
      "type": "string"
    },
    "Suite": {
      "enum": [
        "planted",
        "decoys",
        "corrections",
        "confounded",
        "seeded_false_claims"
      ],
      "title": "Suite",
      "type": "string"
    },
    "Variant": {
      "enum": [
        "A",
        "B",
        "C"
      ],
      "title": "Variant",
      "type": "string"
    }
  },
  "properties": {
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "variant": {
      "$ref": "#/$defs/Variant"
    },
    "suites": {
      "items": {
        "$ref": "#/$defs/Suite"
      },
      "minItems": 1,
      "title": "Suites",
      "type": "array"
    },
    "split": {
      "$ref": "#/$defs/Split"
    },
    "model_tier": {
      "description": "dev | final",
      "title": "Model Tier",
      "type": "string"
    },
    "match_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Match Ids",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricEstimate"
      },
      "minItems": 1,
      "title": "Metrics",
      "type": "array"
    },
    "started_at_ms": {
      "description": "epoch milliseconds",
      "minimum": 0,
      "title": "Started At Ms",
      "type": "integer"
    },
    "finished_at_ms": {
      "description": "epoch milliseconds",
      "minimum": 0,
      "title": "Finished At Ms",
      "type": "integer"
    },
    "input_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "output_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "cost_usd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Usd"
    },
    "foundry_eval_run": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Foundry Eval Run"
    },
    "flags": {
      "anyOf": [
        {
          "$ref": "#/$defs/FlagSet"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the planted suite's frozen not_observable flags (spec \u00a77.2)"
    },
    "outcomes": {
      "items": {
        "$ref": "#/$defs/MatchOutcome"
      },
      "title": "Outcomes",
      "type": "array"
    },
    "suite_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "SHA-256 of scripts and truth",
      "title": "Suite Digest"
    },
    "batch_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "SHA-256 of scored batch files",
      "title": "Batch Digest"
    },
    "failed_cases": {
      "default": 0,
      "minimum": 0,
      "title": "Failed Cases",
      "type": "integer"
    },
    "model_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "tool_call_budget": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Call Budget"
    },
    "wall_time_budget_s": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wall Time Budget S"
    },
    "bootstrap_seed": {
      "default": 0,
      "title": "Bootstrap Seed",
      "type": "integer"
    },
    "bootstrap_resamples": {
      "default": 2000,
      "minimum": 1,
      "title": "Bootstrap Resamples",
      "type": "integer"
    },
    "undefined_metrics": {
      "items": {
        "type": "string"
      },
      "title": "Undefined Metrics",
      "type": "array"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "variant",
    "suites",
    "split",
    "model_tier",
    "match_ids",
    "metrics",
    "started_at_ms",
    "finished_at_ms"
  ],
  "title": "EvalRun",
  "type": "object"
}
