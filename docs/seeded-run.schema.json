{
  "$defs": {
    "CheckResult": {
      "enum": [
        "passed",
        "corrected",
        "failed",
        "skipped"
      ],
      "title": "CheckResult",
      "type": "string"
    },
    "LanguageLevel": {
      "enum": [
        "assertive",
        "measured",
        "tentative"
      ],
      "title": "LanguageLevel",
      "type": "string"
    },
    "MetricEstimate": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "suite": {
          "anyOf": [
            {
              "$ref": "#/$defs/Suite"
            },
            {
              "const": "combined",
              "type": "string"
            }
          ],
          "title": "Suite"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "ci_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Low"
        },
        "ci_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci High"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "ci_method": {
          "anyOf": [
            {
              "enum": [
                "wilson",
                "paired_match_bootstrap"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Method"
        }
      },
      "required": [
        "name",
        "suite",
        "value",
        "n"
      ],
      "title": "MetricEstimate",
      "type": "object"
    },
    "SeedCardResult": {
      "properties": {
        "match_id": {
          "title": "Match Id",
          "type": "string"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "card_id": {
          "title": "Card Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "card_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Card Digest",
          "type": "string"
        },
        "control": {
          "$ref": "#/$defs/Verification"
        },
        "control_no_answer": {
          "default": false,
          "title": "Control No Answer",
          "type": "boolean"
        },
        "trials": {
          "items": {
            "$ref": "#/$defs/SeedTrial"
          },
          "title": "Trials",
          "type": "array"
        }
      },
      "required": [
        "match_id",
        "case_id",
        "card_id",
        "revision",
        "card_digest",
        "control",
        "trials"
      ],
      "title": "SeedCardResult",
      "type": "object"
    },
    "SeedTrial": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/SeedType"
        },
        "applied": {
          "title": "Applied",
          "type": "boolean"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "before": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before"
        },
        "after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After"
        },
        "skip_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skip Reason"
        },
        "verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/Verification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "caught": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caught"
        },
        "no_answer": {
          "default": false,
          "title": "No Answer",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "applied"
      ],
      "title": "SeedTrial",
      "type": "object"
    },
    "SeedType": {
      "enum": [
        "evidence_value",
        "baseline_value",
        "unsupported_number",
        "claim_direction",
        "wrong_team",
        "overcertainty",
        "unnamed_cause",
        "primary_direction"
      ],
      "title": "SeedType",
      "type": "string"
    },
    "SeedTypeResult": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/SeedType"
        },
        "seeded": {
          "minimum": 0,
          "title": "Seeded",
          "type": "integer"
        },
        "caught": {
          "minimum": 0,
          "title": "Caught",
          "type": "integer"
        },
        "no_answer": {
          "default": 0,
          "minimum": 0,
          "title": "No Answer",
          "type": "integer"
        },
        "eligible": {
          "default": 0,
          "minimum": 0,
          "title": "Eligible",
          "type": "integer"
        },
        "eligible_caught": {
          "default": 0,
          "minimum": 0,
          "title": "Eligible Caught",
          "type": "integer"
        },
        "checks": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Checks",
          "type": "object"
        },
        "estimate": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricEstimate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "all_cards_estimate": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricEstimate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "seeded",
        "caught"
      ],
      "title": "SeedTypeResult",
      "type": "object"
    },
    "Split": {
      "enum": [
        "dev",
        "heldout"
      ],
      "title": "Split",
      "type": "string"
    },
    "Suite": {
      "enum": [
        "planted",
        "decoys",
        "corrections",
        "confounded",
        "seeded_false_claims",
        "questions"
      ],
      "title": "Suite",
      "type": "string"
    },
    "SupportLevel": {
      "enum": [
        "strong",
        "moderate",
        "weak"
      ],
      "title": "SupportLevel",
      "type": "string"
    },
    "Variant": {
      "enum": [
        "A",
        "B",
        "C"
      ],
      "title": "Variant",
      "type": "string"
    },
    "Verification": {
      "properties": {
        "status": {
          "enum": [
            "passed",
            "corrected",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "recompute": {
          "enum": [
            "match",
            "mismatch"
          ],
          "title": "Recompute",
          "type": "string"
        },
        "baseline_check": {
          "$ref": "#/$defs/CheckResult"
        },
        "sample_size_check": {
          "$ref": "#/$defs/CheckResult"
        },
        "contradiction_check": {
          "$ref": "#/$defs/CheckResult"
        },
        "number_check": {
          "$ref": "#/$defs/CheckResult",
          "description": "every number in every variant matches evidence"
        },
        "semantic_check": {
          "$ref": "#/$defs/CheckResult"
        },
        "verifier_model_family": {
          "title": "Verifier Model Family",
          "type": "string"
        },
        "support_level": {
          "anyOf": [
            {
              "$ref": "#/$defs/SupportLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "language_level": {
          "anyOf": [
            {
              "$ref": "#/$defs/LanguageLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rejection_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejection Reason"
        }
      },
      "required": [
        "status",
        "recompute",
        "baseline_check",
        "sample_size_check",
        "contradiction_check",
        "number_check",
        "semantic_check",
        "verifier_model_family"
      ],
      "title": "Verification",
      "type": "object"
    }
  },
  "description": "Verifier benchmark with every trial and its proportion intervals retained.",
  "properties": {
    "record_type": {
      "const": "seeded_verifier",
      "default": "seeded_verifier",
      "title": "Record Type",
      "type": "string"
    },
    "record_version": {
      "const": 2,
      "default": 2,
      "title": "Record Version",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "split": {
      "$ref": "#/$defs/Split"
    },
    "variant": {
      "$ref": "#/$defs/Variant"
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "batch_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Batch Digest",
      "type": "string"
    },
    "exchanges_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Exchanges Digest",
      "type": "string"
    },
    "data_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Data Digest",
      "type": "string"
    },
    "verifier_exchanges_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Verifier Exchanges Digest",
      "type": "string"
    },
    "suite_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Suite Digest"
    },
    "flag_set_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Flag Set Id"
    },
    "started_at_ms": {
      "minimum": 0,
      "title": "Started At Ms",
      "type": "integer"
    },
    "finished_at_ms": {
      "minimum": 0,
      "title": "Finished At Ms",
      "type": "integer"
    },
    "bootstrap_seed": {
      "default": 0,
      "title": "Bootstrap Seed",
      "type": "integer"
    },
    "bootstrap_resamples": {
      "default": 2000,
      "minimum": 1,
      "title": "Bootstrap Resamples",
      "type": "integer"
    },
    "input_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "output_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "cards": {
      "items": {
        "$ref": "#/$defs/SeedCardResult"
      },
      "minItems": 1,
      "title": "Cards",
      "type": "array"
    },
    "types": {
      "items": {
        "$ref": "#/$defs/SeedTypeResult"
      },
      "title": "Types",
      "type": "array"
    },
    "catch_rate": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetricEstimate"
        },
        {
          "type": "null"
        }
      ]
    },
    "all_cards_catch_rate": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetricEstimate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "false_rejection_rate": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetricEstimate"
        },
        {
          "type": "null"
        }
      ]
    },
    "seed_no_answers": {
      "default": 0,
      "minimum": 0,
      "title": "Seed No Answers",
      "type": "integer"
    },
    "control_no_answers": {
      "default": 0,
      "minimum": 0,
      "title": "Control No Answers",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "split",
    "variant",
    "batch_digest",
    "exchanges_digest",
    "data_digest",
    "verifier_exchanges_digest",
    "started_at_ms",
    "finished_at_ms",
    "cards",
    "types",
    "catch_rate",
    "false_rejection_rate"
  ],
  "title": "SeededRun",
  "type": "object"
}
